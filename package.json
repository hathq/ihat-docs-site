{
  "name": "@hathq/ihat-docs-site",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "typecheck": "nuxt typecheck",
    "test": "node --test && pnpm run test:site-structure && node products/hatter/site/check.mjs",
    "validate:content": "nuxtjp-localized-site validate --content-root .",
    "test:site-structure": "node --test site/navigation.cases.mts && node site/check.mjs",
    "product:hatter:check": "node --test products/hatter/site/navigation.cases.mts && node products/hatter/site/check.mjs && nuxt typecheck products/hatter",
    "product:hatter:build": "nuxt generate products/hatter"
  },
  "dependencies": {
    "@nuxtjp/localized-site": "0.2.6",
    "nuxt": "4.6.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@nuxtjp/dependency-security": "0.1.0",
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "braces@3.0.3": ".nuxtjp-security/braces-3.0.3.patch",
      "node-forge@1.4.0": ".nuxtjp-security/node-forge-1.4.0.patch",
      "simple-git@4.0.2": ".nuxtjp-security/simple-git-4.0.2.patch"
    },
    "overrides": {
      "simple-git": "4.0.2",
      "@simple-git/argv-parser": "2.0.1",
      "esbuild": "0.28.2"
    }
  }
}
